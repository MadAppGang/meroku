      "name": "valid reuse config",
      "config": {
        "project": "myapp",
        "env": "dev",
        "neon": {
          "mode": "reuse",
          "project_id": "fake-project-000000",
          "pg_version": 17,
          "owner_role": "neondb_owner",
          "databases": [
            {
              "name": "app",
              "create": true
            },
            {
              "name": "analytics",
              "create": false
            }
          ]
        },
        "workload": {
          "backend_neon": {
            "database": "app",
            "schemas": [
              "app",
              "public"
            ],
            "access": "readwrite"
          }
        },
        "services": [
