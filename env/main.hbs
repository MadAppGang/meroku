terraform {
  backend "s3" {
    bucket       = "{{ state_bucket }}"
    key          = "{{ state_file }}"
    region       = "{{ region  }}"
    encrypt      = true
    use_lockfile = true  # Native S3 state locking (Terraform 1.10+)
  }
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.2.6"
}

# Stamp every resource in this environment with identifying tags, so the whole
# application can be found in one query (Resource Groups / Tag Editor:
# Application = "{{ project }}-{{ env }}").
#
# Deliberately no `region` here: today the default provider takes its region
# from AWS_REGION / the profile, and pinning it would silently relocate the
# stack for anyone whose shell region differs from their YAML.
#
# Resource-level tags win over these, so existing tag blocks keep working.
provider "aws" {
  default_tags {
    tags = {
      Application = "{{ project }}-{{ env }}"
      Project     = "{{ project }}"
      Environment = "{{ env }}"
      ManagedBy   = "meroku"
    }
  }
}

# us-east-1 is needed for two unrelated reasons, so it is declared here rather
# than beside either of them: CloudFront requires its certificate there, and IAM
# and Route53 are global services that AWS hosts in us-east-1 and surfaces only
# through that endpoint. It used to live inside the CloudFront block, which meant
# an environment without CloudFront had no way to reach global resources at all.
#
# Aliased providers do not inherit default_tags, so they are repeated.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"

  default_tags {
    tags = {
      Application = "{{ project }}-{{ env }}"
      Project     = "{{ project }}"
      Environment = "{{ env }}"
      ManagedBy   = "meroku"
    }
  }
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

# ==============================================================================
# Resource Groups — one clickable collection per environment
# ==============================================================================
#
# The Application tag above already makes every resource findable, but a tag on
# its own is only reachable through Tag Editor. A resource group turns the same
# tag into an entry in the console you can open.
#
# This is deliberately NOT myApplications. That service is closed to new
# applications and receives no further features; AWS's own recommended
# replacement is exactly this — tag-based resource groups. myApplications also
# used a different tag (awsApplication, valued with a group ARN), which this
# project never adopted, so there is nothing to migrate.
#
# Two groups are needed, not one. Resource groups are regional, and IAM and
# Route53 are global services whose ARNs carry no region at all
# (arn:aws:iam::123456789012:policy/x, arn:aws:route53:::hostedzone/Z1). AWS
# hosts those in us-east-1 and surfaces them only through that endpoint, so a
# group in the deploy region silently omits every policy and hosted zone this
# environment owns. This is documented behaviour, not a workaround: "To create a
# resource group that contains a global resource, you must configure your AWS
# Management Console to US East (N. Virginia) us-east-1."
#
# Known gap: IAM *roles* are tagged by these modules but never appear in either
# group. The Resource Groups Tagging API does not return iam:role at all —
# verified against a live account where six tagged roles yield zero results while
# six tagged policies yield six. Nothing here can fix that; the roles are still
# tagged and findable through the IAM console and `aws iam list-role-tags`.

resource "aws_resourcegroups_group" "application" {
  name        = "{{ project }}-{{ env }}"
  # The API restricts descriptions to [\sa-zA-Z0-9_.-] — no commas, no dashes
  # other than hyphen. It rejects the whole request rather than trimming.
  description = "All {{ project }} {{ env }} resources in this region found by the Application tag"

  resource_query {
    query = jsonencode({
      ResourceTypeFilters = ["AWS::AllSupported"]
      TagFilters = [{
        Key    = "Application"
        Values = ["{{ project }}-{{ env }}"]
      }]
    })
  }
}

resource "aws_resourcegroups_group" "application_global" {
  provider = aws.us_east_1

  name        = "{{ project }}-{{ env }}-global"
  description = "IAM and Route53 for {{ project }} {{ env }} - global resources surface via us-east-1"

  resource_query {
    query = jsonencode({
      ResourceTypeFilters = ["AWS::AllSupported"]
      TagFilters = [{
        Key    = "Application"
        Values = ["{{ project }}-{{ env }}"]
      }]
    })
  }
}

{{#if use_default_vpc}}
# Using default VPC (backward compatibility)
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "all" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}
{{else}}
# Create custom VPC (2 AZs with public subnets only)
module "vpc" {
  source   = "{{ modules }}/vpc"
  project  = "{{ project }}"
  env      = "{{ env }}"
  {{#if vpc_cidr}}
  vpc_cidr = "{{ vpc_cidr }}"
  {{/if}}
}
{{/if}}

# Single point of dependency for VPC resources
# All modules reference these locals instead of conditional logic
locals {
  vpc_id     = {{#if use_default_vpc}}data.aws_vpc.default.id{{else}}module.vpc.vpc_id{{/if}}
  subnet_ids = {{#if use_default_vpc}}data.aws_subnets.all.ids{{else}}module.vpc.subnet_ids{{/if}}
}

{{#if domain.enabled}}
  {{#compare env "==" "prod"}}
    # PROD: Standard domain configuration
    module "domain" {
      source = "{{ modules }}/domain"
      project = "{{ project }}"
      domain_zone = "{{ domain.domain_name }}"
      env = "{{ env }}"
      create_domain_zone = {{ domain.create_domain_zone }}
      api_domain_prefix = "{{ domain.api_domain_prefix }}"
      add_env_domain_prefix = false  # No prefix for production
    }
  {{else}}
    {{#if domain.root_zone_id}}
    # NON-PROD: Create subdomain with delegation
    provider "aws" {
      alias = "root"
      assume_role {
        role_arn = "arn:aws:iam::{{ domain.root_account_id }}:role/dns-delegation"
      }
    }
    
    module "dns_delegation" {
      source = "{{ modules }}/dns-delegation"
      providers = {
        aws.root = aws.root
      }
      subdomain = "{{ env }}.{{ domain.domain_name }}"
      root_domain = "{{ domain.domain_name }}"
      root_zone_id = "{{ domain.root_zone_id }}"
      root_account_id = "{{ domain.root_account_id }}"
      environment = "{{ env }}"
      tags = {
        Project = "{{ project }}"
        Environment = "{{ env }}"
      }
    }
    
    module "domain" {
      source = "{{ modules }}/domain"
      project = "{{ project }}"
      domain_zone = "{{ env }}.{{ domain.domain_name }}"  # Use subdomain
      env = "{{ env }}"
      create_domain_zone = false  # Zone created by dns_delegation
      api_domain_prefix = "{{ domain.api_domain_prefix }}"
      add_env_domain_prefix = false  # Already prefixed
      depends_on = [module.dns_delegation]
    }
    {{else}}
    # Fallback: Standard domain configuration
    module "domain" {
      source = "{{ modules }}/domain"
      project = "{{ project }}"
      domain_zone = "{{ domain.domain_name }}"
      env = "{{ env }}"
      create_domain_zone = {{ domain.create_domain_zone }}
      api_domain_prefix = "{{ domain.api_domain_prefix }}"
      add_env_domain_prefix = {{default domain.add_env_domain_prefix true}}
    }
    {{/if}}
  {{/compare}}

  # ------------------------------------------------------------------------------
  # Additional Domains (Route53 zones and certificates)
  # Configured in domain.additional_domains for centralized domain management
  # ------------------------------------------------------------------------------
  {{#each domain.additional_domains}}
  {{#if create_zone}}
  # Route 53 Zone for additional domain: {{domain}}
  resource "aws_route53_zone" "additional_{{@index}}" {
    name = "{{domain}}"

    tags = {
      Name        = "{{domain}}"
      Project     = "{{@root.project}}"
      Environment = "{{@root.env}}"
      ManagedBy   = "meroku"
    }
  }
  {{/if}}

  {{#unless (eq create_certificate false)}}
  # ACM Certificate in us-east-1 for CloudFront: {{domain}}
  resource "aws_acm_certificate" "additional_{{@index}}" {
    provider = aws.us_east_1

    domain_name               = "{{domain}}"
    subject_alternative_names = ["*.{{domain}}"]
    validation_method         = "DNS"

    lifecycle {
      create_before_destroy = true
    }

    tags = {
      Name        = "{{@root.project}}-{{@root.env}}-additional-{{domain}}"
      Project     = "{{@root.project}}"
      Environment = "{{@root.env}}"
      Domain      = "{{domain}}"
      ManagedBy   = "meroku"
    }
  }

  # DNS validation records for additional domain: {{domain}}
  resource "aws_route53_record" "additional_{{@index}}_validation" {
    for_each = {
      for dvo in aws_acm_certificate.additional_{{@index}}.domain_validation_options : dvo.domain_name => {
        name   = dvo.resource_record_name
        record = dvo.resource_record_value
        type   = dvo.resource_record_type
      }
    }

    allow_overwrite = true
    name            = each.value.name
    records         = [each.value.record]
    ttl             = 60
    type            = each.value.type
    zone_id         = {{#if create_zone}}aws_route53_zone.additional_{{@index}}.zone_id{{else}}"{{zone_id}}"{{/if}}
  }

  # Certificate validation for additional domain: {{domain}}
  resource "aws_acm_certificate_validation" "additional_{{@index}}" {
    provider = aws.us_east_1

    certificate_arn         = aws_acm_certificate.additional_{{@index}}.arn
    validation_record_fqdns = [for record in aws_route53_record.additional_{{@index}}_validation : record.fqdn]
  }
  {{/unless}}
  {{/each}}

  # Locals for additional domain zone lookups (used by CloudFront)
  {{#if domain.additional_domains}}
  locals {
    additional_domain_zones = {
      {{#each domain.additional_domains}}
      "{{domain}}" = {{#if create_zone}}aws_route53_zone.additional_{{@index}}.zone_id{{else}}"{{zone_id}}"{{/if}}{{#unless @last}},{{/unless}}
      {{/each}}
    }
    additional_domain_certs = {
      {{#each domain.additional_domains}}
      {{#unless (eq create_certificate false)}}
      "{{domain}}" = aws_acm_certificate_validation.additional_{{@index}}.certificate_arn{{#unless @last}},{{/unless}}
      {{/unless}}
      {{/each}}
    }
  }
  {{/if}}
{{/if}}


{{#if postgres.enabled}}
module "postgres" {
  source = "{{modules}}/postgres"
  project = "{{project}}"
  env = "{{env}}"
  vpc_id     = local.vpc_id
  subnet_ids = local.subnet_ids
  db_name = "{{postgres.dbname}}"
  username = "{{postgres.username}}"
  public_access = {{ postgres.public_access }}
  engine_version = "{{ postgres.engine_version}}"
  iam_database_authentication_enabled = {{postgres.iam_database_authentication_enabled}}
  {{#if postgres.aurora}}
  aurora = true
  {{!-- Use 'exists' helper to distinguish between "value is 0" (pause when idle) vs "value not set" --}}
  {{#if (exists postgres.min_capacity)}}
  min_capacity = {{postgres.min_capacity}}
  {{/if}}
  {{#if (exists postgres.max_capacity)}}
  max_capacity = {{postgres.max_capacity}}
  {{/if}}
  {{else}}
  {{!-- RDS-specific configuration (when aurora is false) --}}
  instance_class = "{{default postgres.instance_class "db.t4g.micro"}}"
  allocated_storage = {{default postgres.allocated_storage 20}}
  storage_type = "{{default postgres.storage_type "gp3"}}"
  multi_az = {{postgres.multi_az}}
  storage_encrypted = {{postgres.storage_encrypted}}
  deletion_protection = {{postgres.deletion_protection}}
  skip_final_snapshot = {{postgres.skip_final_snapshot}}
  {{/if}}
}
{{/if}}

{{#if sqs.enabled}}
module "sqs" {
  source = "{{modules}}/sqs"
  project = "{{project}}"
  name = "{{sqs.name}}"
  env = "{{env}}"
}
{{/if}}

{{#compare (len efs) ">" 0}}
module "efs" {
  source = "{{modules}}/efs"
  project = "{{project}}"
  env = "{{env}}"
  vpc_id = local.vpc_id
  private_subnets = local.subnet_ids
  efs_configs = {{{array efs}}}
}
{{/compare}}
{{#compare (len buckets) ">" 0}}
module "s3" {
  source = "{{modules}}/s3"
  project = "{{project}}"
  env = "{{env}}"
  buckets = {{{array buckets}}}
}
{{/compare}}
{{#if alb.enabled}}
module "alb" {
  source = "{{modules}}/alb"
  project = "{{project}}"
  env = "{{env}}"
  vpc_id = local.vpc_id
  private_subnets = local.subnet_ids
}
{{/if}}

{{#if has_custom_pre}}
# ============================================================================
# CUSTOM PRE-MODULE (runs before workloads module)
# Source: custom/pre/
# Outputs from this module can feed into workloads (e.g., backend_env_vars)
# ============================================================================
module "custom_pre" {
  source = "{{custom_modules}}/pre"

  # Context variables
  project    = "{{project}}"
  env        = "{{env}}"
  region     = "{{region}}"
  account_id = "{{account_id}}"
  vpc_id     = local.vpc_id
  subnet_ids = local.subnet_ids
}
{{/if}}

{{#compare (len extensions.sns_topics) ">" 0}}
# ============================================================================
# YAML EXTENSIONS - SNS Topics
# Defined in extensions.sns_topics in YAML config
# ============================================================================
{{#each extensions.sns_topics}}
resource "aws_sns_topic" "ext_{{name}}" {
  name = "{{@root.project}}-{{@root.env}}-{{name}}{{#if fifo}}.fifo{{/if}}"
  {{#if display_name}}
  display_name = "{{display_name}}"
  {{/if}}
  {{#if fifo}}
  fifo_topic                  = true
  content_based_deduplication = {{content_based_dedup}}
  {{/if}}
  {{#if kms_key_id}}
  kms_master_key_id = "{{kms_key_id}}"
  {{/if}}

  tags = {
    Name        = "{{@root.project}}-{{@root.env}}-{{name}}"
    Project     = "{{@root.project}}"
    Environment = "{{@root.env}}"
    ManagedBy   = "meroku-extensions"
  }
}
{{/each}}
{{/compare}}

{{#compare (len extensions.sqs_queues) ">" 0}}
# ============================================================================
# YAML EXTENSIONS - SQS Queues
# Defined in extensions.sqs_queues in YAML config
# ============================================================================
{{#each extensions.sqs_queues}}
{{#if dlq_enabled}}
# Dead Letter Queue for {{name}}
resource "aws_sqs_queue" "ext_{{name}}_dlq" {
  name = "{{@root.project}}-{{@root.env}}-{{name}}-dlq{{#if fifo}}.fifo{{/if}}"
  {{#if fifo}}
  fifo_queue                  = true
  content_based_deduplication = true
  {{/if}}
  message_retention_seconds = {{default dlq_retention 1209600}}
  {{#if kms_key_id}}
  kms_master_key_id = "{{kms_key_id}}"
  {{/if}}

  tags = {
    Name        = "{{@root.project}}-{{@root.env}}-{{name}}-dlq"
    Project     = "{{@root.project}}"
    Environment = "{{@root.env}}"
    ManagedBy   = "meroku-extensions"
  }
}
{{/if}}

resource "aws_sqs_queue" "ext_{{name}}" {
  name = "{{@root.project}}-{{@root.env}}-{{name}}{{#if fifo}}.fifo{{/if}}"
  {{#if fifo}}
  fifo_queue                  = true
  content_based_deduplication = true
  {{/if}}
  visibility_timeout_seconds = {{default visibility_timeout 30}}
  message_retention_seconds  = {{default message_retention 345600}}
  max_message_size          = {{default max_message_size 262144}}
  delay_seconds             = {{default delay_seconds 0}}
  receive_wait_time_seconds = {{default receive_wait_time 0}}
  {{#if kms_key_id}}
  kms_master_key_id = "{{kms_key_id}}"
  {{/if}}
  {{#if dlq_enabled}}
  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.ext_{{name}}_dlq.arn
    maxReceiveCount     = {{default dlq_max_receive 3}}
  })
  {{/if}}

  tags = {
    Name        = "{{@root.project}}-{{@root.env}}-{{name}}"
    Project     = "{{@root.project}}"
    Environment = "{{@root.env}}"
    ManagedBy   = "meroku-extensions"
  }
}
{{/each}}
{{/compare}}

module "workloads" {
  source = "{{ modules }}/workloads"
  project    = "{{project}}"
  env        = "{{env}}" 
  private_dns_name = "{{project}}_{{env}}.private"
  {{#if domain.enabled}}
  enable_custom_domain = module.domain.enable_custom_domain
  api_domain = module.domain.api_domain_name
  {{#notEmpty domain.api_domain_prefix}}
  create_api_domain_record = true
  {{else}}
  create_api_domain_record = false
  {{/notEmpty}}
  {{else}}
  {{!-- Don't set api_domain when domain module is disabled to prevent API Gateway domain creation without certificate --}}
  enable_custom_domain = false
  api_domain = ""
  create_api_domain_record = false
  {{/if}}
  domain = "{{ domain.domain_name }}"
  vpc_id     = local.vpc_id
  subnet_ids = local.subnet_ids
{{!-- lambda_path is deliberately not emitted: the CI Lambda artifact is built by
      modules/workloads/lambda.tf at apply time into ci_lambda/.build/<env>/, and
      nothing reads a module-root bootstrap. The variable stays declared in
      modules/workloads/variables.tf so already generated env/*/main.tf that
      still pass it keep applying. --}}
  slack_deployment_webhook = "{{workload.slack_webhook}}"
  backend_bucket_postfix = "{{workload.bucket_postfix}}"
  backend_bucket_public = {{workload.bucket_public}}
  backend_health_endpoint = "{{workload.backend_health_endpoint}}"
  backend_remote_access = {{default workload.backend_remote_access true}}
  docker_image = "{{workload.backend_external_docker_image}}"
  setup_FCM_SNS = {{workload.setup_fcnsns}}
  backend_image_port = {{workload.backend_image_port}}
  {{#if postgres.enabled}}

  db_endpoint = module.postgres.endpoint
  db_user = module.postgres.user
  db_name = module.postgres.db_name
  {{/if}}
  {{#if domain.enabled}}
  subdomains_certificate_arn = module.domain.subdomains_certificate_arn
  api_certificate_arn = module.domain.api_certificate_arn
  domain_zone_id = module.domain.zone_id
  {{/if}}
  ecr_strategy = "{{ecr_strategy}}"
  {{#if ecr_account_id}}
  ecr_account_id = "{{ecr_account_id}}"
  {{/if}}
  {{#if ecr_account_region}}
  ecr_account_region = "{{ecr_account_region}}"
  {{/if}}
  {{#if ecr_account_id}}{{#if ecr_account_region}}
  ecr_url = "{{ecr_account_id}}.dkr.ecr.{{ecr_account_region}}.amazonaws.com/{{project}}_backend"
  {{/if}}{{/if}}
  {{#notEmpty ecr_trusted_accounts}}
  ecr_trusted_accounts = [
    {{#each ecr_trusted_accounts}}
    {
      account_id = "{{account_id}}"
      env        = "{{env}}"
      region     = "{{region}}"
    },
    {{/each}}
  ]
  {{else}}
  ecr_trusted_accounts = []
  {{/notEmpty}}
  github_oidc_enabled = {{workload.enable_github_oidc}}
  github_subjects = {{{array workload.github_oidc_subjects}}}
  {{#if workload.backend_container_command}}
  backend_container_command = {{array backend_container_command}}
  {{/if}}
  xray_enabled = {{workload.xray_enabled}}
  pgadmin_enabled = {{workload.install_pg_admin}}
  pgadmin_email = "{{workload.pg_admin_email}}"
  # Backend environment variables merged from:
  # 1. YAML backend_env_variables
  # 2. Custom pre-module outputs (if exists)
  # 3. YAML extensions (SNS topics, SQS queues with add_to_backend_env)
  backend_env = concat(
    {{{ envArray workload.backend_env_variables }}}{{#if has_custom_pre}},
    try(module.custom_pre.backend_env_vars, []){{/if}}{{#each extensions.sns_topics}}{{#if add_to_backend_env}},
    [{ name = "{{add_to_backend_env}}", value = aws_sns_topic.ext_{{name}}.arn }]{{/if}}{{/each}}{{#each extensions.sqs_queues}}{{#if add_to_backend_env}},
    [{ name = "{{add_to_backend_env}}", value = aws_sqs_queue.ext_{{name}}.url }]{{/if}}{{#if add_arn_to_backend_env}},
    [{ name = "{{add_arn_to_backend_env}}", value = aws_sqs_queue.ext_{{name}}.arn }]{{/if}}{{/each}}
  )

  # May the CI/CD Lambda redeploy the backend on its own when a new image or a
  # new configuration lands? false does not remove anything from the Lambda's
  # maps: the flag travels to it as data so a push still logs "auto_deploy is
  # disabled for backend" instead of nothing. Manual deploys are unaffected.
  # Absent means true — that is what a project from before this setting does.
  backend_auto_deploy = {{default workload.backend_auto_deploy true}}

  # Backend scaling configuration
  backend_cpu = {{default workload.backend_cpu 256}}
  backend_memory = {{default workload.backend_memory 512}}
  backend_desired_count = {{default workload.backend_desired_count 1}}

  # Backend autoscaling configuration
  backend_autoscaling_enabled = {{default workload.backend_autoscaling_enabled false}}
  backend_autoscaling_min_capacity = {{default workload.backend_autoscaling_min_capacity 1}}
  backend_autoscaling_max_capacity = {{default workload.backend_autoscaling_max_capacity 10}}
  backend_autoscaling_target_cpu = {{default workload.backend_autoscaling_target_cpu 70}}
  backend_autoscaling_target_memory = {{default workload.backend_autoscaling_target_memory 80}}
  {{#if sqs.enabled}}
  sqs_queue_url = module.sqs.queue_url
  sqs_policy_arn = module.sqs.sqs_access_policy_arn
  sqs_enable = true
  {{/if}}
  {{#if ses.enabled}}
  ses_enabled = true
  {{/if}}
  {{#compare (len workload.efs) ">" 0}}
  available_efs = { 
    {{#each efs}}
    {{name}} = {
      id = module.efs.efs_configs.{{name}}.id
      access_point_id = module.efs.efs_configs.{{name}}.access_point_id
      dns_name = module.efs.efs_configs.{{name}}.dns_name
      security_group = module.efs.efs_configs.{{name}}.security_group
      root_directory = module.efs.efs_configs.{{name}}.path
    }
    {{/each}}
  }
  backend_efs_mounts = [
    {{#each workload.efs}}
    {
      efs_name = "{{name}}"
      mount_point = "{{mount_point}}"
    },
    {{/each}}
  ]
  {{/compare}}
  {{#compare (len workload.env_files_s3) ">" 0}}
  env_files_s3 = {{{array workload.env_files_s3}}} 
  {{/compare}}
  {{#if alb.enabled}}{{#if workload.backend_alb_domain_name}}
  backend_alb_domain_name = "{{workload.backend_alb_domain_name}}"
  alb_arn = module.alb.alb_arn
  enable_alb = true
  {{/if}}{{/if}}
  {{#compare (len services) ">" 0}}
  services = {{{array services}}} 
  {{/compare}}
  backend_policy = [
  {{#each workload.policy}}
    {
      actions = {{{array actions}}}
      resources = {{{array resources}}}
    }{{#unless @last}},{{/unless}}
  {{/each}}
  ]
  {{#compare (len scheduled_tasks) ">" 0}}
  scheduled_task_names = [{{#each scheduled_tasks}}"{{name}}"{{#unless @last}}, {{/unless}}{{/each}}]
  # Per-task auto-deploy policy. Outside dev no automatic trigger reaches a
  # scheduled task at all (modules/ecs_task creates its ECR repository only in
  # dev, and an SSM change never redeploys a task), so true there enables only
  # the manual path -- see modules/workloads/ci_lambda/README.md.
  scheduled_task_auto_deploy = {
    {{#each scheduled_tasks}}
    "{{name}}" = {{default auto_deploy true}}
    {{/each}}
  }
  {{/compare}}
}
{{#if cognito.enabled}} 
module "cognito" {
  source                  = "{{modules}}/cognito"
  project                 = "{{project}}"
  env                     = "{{env}}"
  enable_web_client       = "{{cognito.enable_web_client}}"
  enable_dashboard_client = {{cognito.enable_dashboard_client}}
  dashboard_callback_urls = {{array cognito.dashboard_callback_urls}}

  enable_user_pool_domain = {{cognito.enable_user_pool_domain}}
  user_pool_domain_prefix = "{{cognito.user_pool_domain_prefix}}"

  allow_backend_task_to_confirm_signup = {{cognito.backend_confirm_signup}}
  auto_verified_attributes = {{array cognito.auto_verified_attributes}}
