{{#if cloudfront_distributions}}
# ============================================================================
# CLOUDFRONT CDN DISTRIBUTIONS (Multiple distributions support)
# Supports wildcard domains and path-based routing
# ============================================================================

{{#each cloudfront_distributions}}
{{#if enabled}}
# ------------------------------------------------------------------------------
# CloudFront Distribution: {{name}}
# ------------------------------------------------------------------------------

# Additional Route 53 zones for non-main domain aliases
{{#each additional_zones}}
{{#if create_zone}}
resource "aws_route53_zone" "cloudfront_{{../name}}_{{@index}}" {
  name = "{{domain}}"

  tags = {
    Name         = "{{domain}}"
    Project      = "{{@root.project}}"
    Environment  = "{{@root.env}}"
    Distribution = "{{../name}}"
    ManagedBy    = "meroku"
  }
}
{{/if}}
{{/each}}

{{#if (or additional_zones @root.domain.additional_domains)}}
# Zone lookup map for certificate validation (maps domain suffix to zone_id)
# Includes: main domain + CloudFront additional_zones (legacy) + domain.additional_domains (centralized)
locals {
  cloudfront_{{name}}_zone_map = merge(
    # Main domain zone (default fallback)
    {{#if @root.domain.enabled}}
    {
      "{{@root.domain.domain_name}}" = module.domain.zone_id
    },
    {{/if}}
    # Centralized additional domains from domain.additional_domains (preferred)
    {{#if @root.domain.additional_domains}}
    local.additional_domain_zones,
    {{/if}}
    # Legacy CloudFront additional_zones (for backward compatibility)
    {{#if additional_zones}}
    {
      {{#each additional_zones}}
      "{{domain}}" = {{#if create_zone}}aws_route53_zone.cloudfront_{{../name}}_{{@index}}.zone_id{{else}}"{{zone_id}}"{{/if}}{{#unless @last}},{{/unless}}
      {{/each}}
    }
    {{else}}
    {}
    {{/if}}
  )
}
{{/if}}

# Wildcard certificate for CloudFront domains (must be in us-east-1)
{{#if domain_aliases}}
resource "aws_acm_certificate" "cloudfront_{{name}}" {
  provider = aws.us_east_1

  # Use the first domain alias as the main domain
  domain_name = "{{domain_aliases.[0]}}"

  # Add remaining aliases as SANs
  {{#if (gt (len domain_aliases) 1)}}
  subject_alternative_names = [
    {{#each domain_aliases}}
    {{#unless @first}}
    "{{this}}"{{#unless @last}},{{/unless}}
    {{/unless}}
    {{/each}}
  ]
  {{/if}}

  validation_method = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = {
    Name        = "{{@root.project}}-{{@root.env}}-cloudfront-{{name}}-cert"
    Project     = "{{@root.project}}"
    Environment = "{{@root.env}}"
    Distribution = "{{name}}"
    ManagedBy   = "meroku"
  }
}

# DNS validation for CloudFront certificate: {{name}}
{{#if (or additional_zones @root.domain.additional_domains)}}
# Helper function to find zone_id for a domain (uses merged zone map)
locals {
  cloudfront_{{name}}_domain_to_zone = {
    for dvo in aws_acm_certificate.cloudfront_{{name}}.domain_validation_options : dvo.domain_name => {
      name    = dvo.resource_record_name
      record  = dvo.resource_record_value
      type    = dvo.resource_record_type
      zone_id = try(
        # Try to find matching zone from additional zones (longest match wins)
        [for domain, zone_id in local.cloudfront_{{name}}_zone_map : zone_id if endswith(dvo.domain_name, domain) || endswith(trimprefix(dvo.domain_name, "*."), domain)][0],
        # Fallback to main domain zone
        module.domain.zone_id
      )
    }
  }
}

resource "aws_route53_record" "cloudfront_{{name}}_cert_validation" {
  for_each = local.cloudfront_{{name}}_domain_to_zone

  allow_overwrite = true
  name            = each.value.name
  records         = [each.value.record]
  ttl             = 60
  type            = each.value.type
  zone_id         = each.value.zone_id
}
{{else}}
resource "aws_route53_record" "cloudfront_{{name}}_cert_validation" {
  for_each = {
    for dvo in aws_acm_certificate.cloudfront_{{name}}.domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  }

  allow_overwrite = true
  name            = each.value.name
  records         = [each.value.record]
  ttl             = 60
  type            = each.value.type
  zone_id         = module.domain.zone_id
}
{{/if}}

resource "aws_acm_certificate_validation" "cloudfront_{{name}}" {
  provider = aws.us_east_1

  certificate_arn         = aws_acm_certificate.cloudfront_{{name}}.arn
  validation_record_fqdns = [for record in aws_route53_record.cloudfront_{{name}}_cert_validation : record.fqdn]
}

# Route53 A records pointing domain aliases to CloudFront distribution
{{#if (or additional_zones @root.domain.additional_domains)}}
# Using zone map for multi-domain support
locals {
  cloudfront_{{name}}_alias_records = {
    {{#each domain_aliases}}
    "{{this}}" = {
      name    = "{{this}}"
      zone_id = try(
        [for domain, zone_id in local.cloudfront_{{../name}}_zone_map : zone_id
         if endswith("{{this}}", domain) || endswith(trimprefix("{{this}}", "*."), domain)][0],
        module.domain.zone_id
      )
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}

resource "aws_route53_record" "cloudfront_{{name}}_alias" {
  for_each = local.cloudfront_{{name}}_alias_records

  zone_id = each.value.zone_id
  name    = each.value.name
  type    = "A"

  alias {
    name                   = module.cloudfront_{{name}}.distribution_domain_name
    zone_id                = module.cloudfront_{{name}}.distribution_hosted_zone_id
    evaluate_target_health = false
  }
}
{{else}}
# Single domain - all aliases use main domain zone
{{#each domain_aliases}}
resource "aws_route53_record" "cloudfront_{{../name}}_alias_{{@index}}" {
  zone_id = module.domain.zone_id
  name    = "{{this}}"
  type    = "A"

  alias {
    name                   = module.cloudfront_{{../name}}.distribution_domain_name
    zone_id                = module.cloudfront_{{../name}}.distribution_hosted_zone_id
    evaluate_target_health = false
  }
}
{{/each}}
{{/if}}
{{/if}}

# S3 Buckets for CloudFront origins (when create_bucket is true)
{{#each origins}}
{{#if create_bucket}}
{{#compare type "==" "s3"}}
resource "aws_s3_bucket" "cloudfront_{{@root.name}}_{{name}}" {
  bucket = "{{@root.project}}-{{@root.env}}-cf-{{@root.name}}-{{name}}"

  tags = {
    Name         = "{{@root.project}}-{{@root.env}}-cf-{{@root.name}}-{{name}}"
    Environment  = "{{@root.env}}"
    Project      = "{{@root.project}}"
    Distribution = "{{@root.name}}"
    Origin       = "{{name}}"
    ManagedBy    = "meroku"
  }
}

resource "aws_s3_bucket_versioning" "cloudfront_{{@root.name}}_{{name}}" {
  bucket = aws_s3_bucket.cloudfront_{{@root.name}}_{{name}}.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_public_access_block" "cloudfront_{{@root.name}}_{{name}}" {
  bucket = aws_s3_bucket.cloudfront_{{@root.name}}_{{name}}.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}
{{/compare}}
{{/if}}
{{/each}}

module "cloudfront_{{name}}" {
  source = "{{@root.modules}}/cloudfront"

  project = "{{@root.project}}"
  env     = "{{@root.env}}"
  name    = "{{name}}"

  # Origins configuration
  origins = [
    {{#each origins}}
    {
      name        = "{{name}}"
      type        = "{{type}}"
      {{#if domain_name}}
      domain_name = "{{domain_name}}"
      {{else}}
        {{#compare type "==" "amplify"}}
      domain_name = module.amplify.production_domains["{{amplify_app_name}}"]
        {{/compare}}
        {{#compare type "==" "s3"}}
        {{#if create_bucket}}
      domain_name = aws_s3_bucket.cloudfront_{{@root.name}}_{{name}}.bucket_regional_domain_name
        {{else}}
      domain_name = "{{bucket_name}}.s3.{{@root.region}}.amazonaws.com"
        {{/if}}
        {{/compare}}
        {{#compare type "==" "alb"}}
      domain_name = module.workloads.alb_dns_name
        {{/compare}}
      {{/if}}
      {{#if origin_path}}
      origin_path = "{{origin_path}}"
      {{/if}}
      {{#if protocol_policy}}
      protocol_policy = "{{protocol_policy}}"
      {{/if}}
      {{#compare type "==" "s3"}}
      use_oac = {{default use_oac true}}
      {{/compare}}
      {{#if custom_headers}}
      custom_headers = {
        {{#each custom_headers}}
        "{{@key}}" = "{{this}}"{{#unless @last}},{{/unless}}
        {{/each}}
      }
      {{/if}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]

  # Domain aliases (including wildcards like *.app.domain.com)
  {{#if domain_aliases}}
  domain_aliases = {{{array domain_aliases}}}
  certificate_arn = aws_acm_certificate_validation.cloudfront_{{name}}.certificate_arn
  {{/if}}

  {{#if @root.domain.enabled}}
  zone_id            = module.domain.zone_id
  create_dns_records = true
  {{else}}
  create_dns_records = false
  {{/if}}

  # Cache behaviors for path-based routing
  {{#if cache_behaviors}}
  cache_behaviors = [
    {{#each cache_behaviors}}
    {
      path_pattern     = "{{path_pattern}}"
      origin_name      = "{{origin_name}}"
      {{#if allowed_methods}}
      allowed_methods  = {{{array allowed_methods}}}
      {{/if}}
      {{#if cached_methods}}
      cached_methods   = {{{array cached_methods}}}
      {{/if}}
      {{#if forward_headers}}
      forward_headers  = {{{array forward_headers}}}
      {{/if}}
      forward_query_string = {{default forward_query_string true}}
      forward_cookies      = "{{default forward_cookies "none"}}"
      viewer_protocol_policy = "{{default viewer_protocol_policy "redirect-to-https"}}"
      min_ttl     = {{default min_ttl 0}}
      default_ttl = {{default default_ttl 0}}
      max_ttl     = {{default max_ttl 0}}
      compress    = {{default compress true}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
  {{/if}}

  # SPA mode for React/Vue/Angular applications
  {{#if spa_mode}}
  custom_error_responses = [
    {
      error_code         = 403
      response_code      = 200
      response_page_path = "/index.html"
    },
    {
      error_code         = 404
      response_code      = 200
      response_page_path = "/index.html"
    }
  ]
  {{/if}}

  default_root_object = "{{default default_root_object "index.html"}}"
  price_class         = "{{default price_class "PriceClass_100"}}"

  # For Amplify origins, do NOT forward Host header (causes 403 error)
  # For ALB/custom origins, forward Host header as needed
  {{#each origins}}{{#if @first}}
    {{#compare type "==" "amplify"}}
  forward_headers = ["Origin", "Access-Control-Request-Headers", "Access-Control-Request-Method"]
    {{else}}
  forward_headers = ["Host", "Origin", "Access-Control-Request-Headers", "Access-Control-Request-Method"]
    {{/compare}}
  {{/if}}{{/each}}

  {{#if logging}}
  {{#if logging.enabled}}
  logging_bucket          = "{{logging.bucket_name}}.s3.amazonaws.com"
  logging_prefix          = "{{default logging.prefix (concat @root.project "/" @root.env "/" name "/")}}"
  logging_include_cookies = {{default logging.include_cookies false}}
  {{/if}}
  {{/if}}

  tags = {
    Project      = "{{@root.project}}"
    Environment  = "{{@root.env}}"
    Distribution = "{{name}}"
    ManagedBy    = "meroku"
  }

  depends_on = [
    {{#if domain_aliases}}
    aws_acm_certificate_validation.cloudfront_{{name}}
    {{/if}}
  ]
}
{{/if}}
{{/each}}

# S3 Bucket Policies for CloudFront OAC access (when create_bucket is true)
{{#each cloudfront_distributions}}
{{#if enabled}}
{{#each origins}}
{{#if create_bucket}}
{{#compare type "==" "s3"}}
resource "aws_s3_bucket_policy" "cloudfront_{{@root.name}}_{{name}}" {
  bucket = aws_s3_bucket.cloudfront_{{@root.name}}_{{name}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AllowCloudFrontServicePrincipal"
        Effect    = "Allow"
        Principal = {
          Service = "cloudfront.amazonaws.com"
        }
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.cloudfront_{{@root.name}}_{{name}}.arn}/*"
        Condition = {
          StringEquals = {
            "AWS:SourceArn" = module.cloudfront_{{@root.name}}.distribution_arn
          }
        }
      }
    ]
  })

  depends_on = [
    aws_s3_bucket_public_access_block.cloudfront_{{@root.name}}_{{name}},
    module.cloudfront_{{@root.name}}
  ]
}
{{/compare}}
{{/if}}
{{/each}}
{{/if}}
{{/each}}
{{/if}}

output "backend_ecr_repo_url" {
  value = module.workloads.backend_ecr_repo_url
}

output "account_id" {
  value = module.workloads.account_id
}

output "region" {
  value = data.aws_region.current.name
}

output "backend_task_role_name" {
  value = module.workloads.backend_task_role_name
}

output "backend_cloud_map_arn" {
  description = "value of the backend service discovery ARN"
  value       = module.workloads.backend_cloud_map_arn
}

{{#if has_custom_post}}
# ============================================================================
# CUSTOM POST-MODULE (runs after core modules)
# Source: custom/post/
# ============================================================================
module "custom_post" {
  source = "{{custom_modules}}/post"

  # Context variables
  project    = "{{project}}"
  env        = "{{env}}"
  region     = "{{region}}"
  account_id = "{{account_id}}"
  vpc_id     = local.vpc_id
  subnet_ids = local.subnet_ids

  # Core module outputs
  api_endpoint         = module.workloads.api_gateway_endpoint
  api_gateway_id       = module.workloads.api_gateway_id
  ecs_cluster_arn      = module.workloads.ecr_cluster.arn
  ecs_cluster_name     = module.workloads.ecr_cluster.name
  backend_ecr_repo_url = module.workloads.backend_ecr_repo_url
  backend_task_role    = module.workloads.backend_task_role_name

  {{#if domain.enabled}}
  # Domain outputs
  domain_zone_id = module.domain.zone_id
  api_domain     = module.domain.api_domain_name
  {{/if}}

  {{#if postgres.enabled}}
  # Database outputs
  db_endpoint = module.postgres.endpoint
  {{/if}}
}
{{/if}}

{{#compare (len amplify_apps) ">" 0}}
output "amplify_apps" {
  description = "Map of all Amplify app details including branches"
  value = module.amplify.amplify_apps
}

output "amplify_app_urls" {
  description = "Map of primary URLs to access the Amplify applications"
  value = module.amplify.app_urls
}

output "amplify_branch_urls" {
  description = "Map of all branch URLs for each Amplify app"
  value = module.amplify.branch_urls
}

{{#each amplify_apps}}
output "amplify_{{name}}_app_id" {
  description = "The unique ID of the {{name}} Amplify app"
  value       = module.amplify.app_ids["{{name}}"]
}

output "amplify_{{name}}_app_url" {
  description = "The URL to access the {{name}} Amplify application"
  value       = module.amplify.app_urls["{{name}}"]
}

output "amplify_{{name}}_default_domain" {
  description = "The default domain for the {{name}} Amplify app"
  value       = module.amplify.default_domains["{{name}}"]
}

output "amplify_{{name}}_branches" {
  description = "All branches for the {{name}} Amplify app"
  value       = module.amplify.amplify_apps["{{name}}"].branches
}
{{/each}}
{{/compare}}

{{#if cloudfront_distributions}}
output "cloudfront_distributions" {
  description = "CloudFront distributions information"
  value = {
    {{#each cloudfront_distributions}}
    {{#if enabled}}
    "{{name}}" = {
      distribution_id     = module.cloudfront_{{name}}.distribution_id
      distribution_domain = module.cloudfront_{{name}}.distribution_domain_name
      domain_aliases      = module.cloudfront_{{name}}.domain_aliases
    }
    {{/if}}
    {{/each}}
  }
}
{{/if}}
