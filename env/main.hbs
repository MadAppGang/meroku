# Email domain configuration (Schema v17: Multi-domain support)
{{#if ses.enabled}}
module "ses" {
  source = "{{modules}}/ses"
  project = "{{project}}"
  env     = "{{env}}"

  {{#if ses.domains}}
  # Multi-domain configuration (Schema v17+)
  # Auto-detects zone_id from Route53 domain module or additional_domains
  domains = [
    {{#each ses.domains}}
    {
      domain = "{{this.domain}}"
      {{#if this.zone_id}}
      # Explicit zone_id provided
      zone_id = "{{this.zone_id}}"
      {{else}}
        {{!-- First check additional_domains for exact or parent domain match --}}
        {{#each ../domain.additional_domains}}
          {{#if (or (eq this.domain ../this.domain) (isSubdomainOf ../this.domain this.domain))}}
            {{#if this.zone_id}}
      zone_id = "{{this.zone_id}}"  # From additional_domains: {{this.domain}}
            {{else}}
              {{#if this.create_zone}}
      zone_id = aws_route53_zone.additional_{{@index}}.zone_id  # From additional_domains: {{this.domain}}
              {{/if}}
            {{/if}}
          {{/if}}
        {{/each}}
        {{!-- Then check main domain module --}}
        {{#if ../domain.enabled}}
          {{#compare ../env "==" "prod"}}
            {{#if (isSubdomainOf this.domain ../domain.domain_name)}}
      zone_id = module.domain.zone_id  # Auto-detected: subdomain of {{../domain.domain_name}}
            {{/if}}
          {{else}}
            {{#if (isSubdomainOf this.domain ../domain.domain_name)}}
      zone_id = module.domain.zone_id  # Auto-detected: subdomain of {{../env}}.{{../domain.domain_name}}
            {{/if}}
          {{/compare}}
        {{/if}}
      {{/if}}
      {{#if (exists this.enable_mail_from)}}
      enable_mail_from = {{this.enable_mail_from}}
      {{/if}}
      {{#if this.mail_from_subdomain}}
      mail_from_subdomain = "{{this.mail_from_subdomain}}"
      {{/if}}
      {{#if this.dmarc_policy}}
      dmarc_policy = "{{this.dmarc_policy}}"
      {{/if}}
      {{#if this.dmarc_rua_email}}
      dmarc_rua_email = "{{this.dmarc_rua_email}}"
      {{/if}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
  {{else}}
  # Legacy single domain configuration (backward compatibility)
  {{#if ses.domain_name}}
  domain = "{{ses.domain_name}}"
  {{else}}
    {{#compare env "==" "prod"}}
  domain = "mail.{{ domain.domain_name }}"
    {{else}}
  domain = "mail.{{ env }}.{{ domain.domain_name }}"
    {{/compare}}
  {{/if}}
  {{#if domain.enabled}}
  zone_id = module.domain.zone_id
  {{/if}}
  {{/if}}

  # Test email addresses (account-wide, not per-domain)
  {{#if ses.test_emails}}
  test_emails = {{{array ses.test_emails}}}
  {{else}}
  test_emails = []
  {{/if}}

  # Global email deliverability configuration
  global_enable_mail_from    = {{default ses.enable_mail_from true}}
  global_mail_from_subdomain = "{{default ses.mail_from_subdomain "bounce"}}"
  global_dmarc_policy        = "{{default ses.dmarc_policy "none"}}"
  {{#if ses.dmarc_rua_email}}
  global_dmarc_rua_email     = "{{ses.dmarc_rua_email}}"
  {{/if}}
}
{{/if}}



{{#if pubsub_appsync.enabled}}
module "appsync" {
  source = "{{modules}}/appsync"
  project = "{{project}}"
  env = "{{env}}"
  {{#if pubsub_appsync.schema}}
  schema_file = "{{custom_modules}}/appsync/schema.graphql"
  {{/if}}
  {{#if pubsub_appsync.resolvers}}
  vtl_templates_yaml = "{{custom_modules}}/appsync/vtl_templates.yaml"
  {{/if}}

  # How callers are authenticated. cognito and oidc are verified by AppSync
  # itself, with no Lambda on the request path; lambda deploys the bundled
  # authorizer and exists for providers those two cannot express. An absent
  # auth_mode means "lambda", which is what this module hardcoded before the
  # setting existed.
  auth_mode = "{{default pubsub_appsync.auth_mode "lambda"}}"

  # An API key bypasses auth_mode entirely: whoever holds it reaches every
  # resolver without presenting a token. It used to be attached unconditionally.
  api_key_enabled = {{default pubsub_appsync.api_key_enabled false}}
  {{#if (eq (default pubsub_appsync.auth_mode "lambda") "cognito")}}

  # AWS validates the token against the user pool this environment creates.
  # meroku refuses to generate this block unless cognito.enabled is true, so the
  # module reference below always resolves.
  cognito_user_pool_id = module.cognito.user_pool_id
  {{#if pubsub_appsync.cognito_app_id_client_regex}}
  # Which app clients of that pool are accepted. Without this, a token minted for
  # any client on the pool (web, mobile, dashboard) is accepted - user pool mode
  # has no other audience check.
  cognito_app_id_client_regex = "{{pubsub_appsync.cognito_app_id_client_regex}}"
  {{/if}}
  {{/if}}
  {{#if (eq (default pubsub_appsync.auth_mode "lambda") "oidc")}}

  # AWS fetches this issuer's OIDC discovery document and signing keys and
  # verifies every token against them. No default: whoever controls this URL can
  # mint tokens the API accepts.
  oidc_issuer = "{{pubsub_appsync.oidc_issuer}}"
  {{#if pubsub_appsync.oidc_client_id}}
  # AppSync's audience check - it has no separate audience field. Matched against
  # the token's `aud` claim, falling back to `azp`. Pipe-separate to accept
  # several clients: "1F4G9H|1J6L4B".
  oidc_client_id = "{{pubsub_appsync.oidc_client_id}}"
  {{/if}}
  {{/if}}
  {{#if (eq (default pubsub_appsync.auth_mode "lambda") "lambda")}}
  {{#if pubsub_appsync.auth_lambda}}
  auth_lambda_path = "{{custom_modules}}/appsync/auth_lambda"
  {{/if}}

  # Trust anchor for the Lambda authorizer: the JWKS endpoint whose keys sign the
  # tokens this API accepts. The module declares it with no default (an unset
  # value used to mean "trust a hardcoded third party"), so it is passed on every
  # lambda-mode instantiation and meroku rejects an empty one at generate time.
  jwks_uri = "{{pubsub_appsync.jwks_uri}}"
  {{#if pubsub_appsync.jwt_issuer}}
  jwt_issuer = "{{pubsub_appsync.jwt_issuer}}"
  {{/if}}
  {{#if pubsub_appsync.jwt_audience}}
  jwt_audience = "{{pubsub_appsync.jwt_audience}}"
  {{/if}}
  {{#if pubsub_appsync.required_claims}}
  # Claims a verified token must carry, checked after signature/issuer/audience.
  # The reason to be in lambda mode at all: neither native mode can check a claim
  # beyond iss and aud. An empty list means "must be present".
  required_claims = {{stringListMap pubsub_appsync.required_claims}}
  {{/if}}
  {{/if}}
}
{{/if}}

{{#compare (len extensions.sns_topics) ">" 0}}
# ============================================================================
# YAML EXTENSIONS - SNS Webhook Subscriptions
# HTTP(S) subscriptions to SNS topics (requires API Gateway endpoint)
# ============================================================================
{{#each extensions.sns_topics}}
{{#each webhooks}}
resource "aws_sns_topic_subscription" "ext_{{../name}}_webhook_{{@index}}" {
  topic_arn              = aws_sns_topic.ext_{{../name}}.arn
  protocol               = "https"
  endpoint               = "${module.workloads.api_gateway_endpoint}{{path}}"
  endpoint_auto_confirms = true
  {{#if raw_message_delivery}}
  raw_message_delivery   = true
  {{/if}}
  {{#if filter_policy}}
  filter_policy = jsonencode({{{json filter_policy}}})
  {{/if}}
}
{{/each}}
{{/each}}
{{/compare}}

{{#compare (len extensions.sqs_queues) ">" 0}}
# ============================================================================
# YAML EXTENSIONS - SQS to SNS Subscriptions
# Subscribe SQS queues to SNS topics for fan-out pattern
# ============================================================================
{{#each extensions.sqs_queues}}
{{#each sns_subscriptions}}
resource "aws_sns_topic_subscription" "ext_{{../name}}_sns_{{this}}" {
  topic_arn            = aws_sns_topic.ext_{{this}}.arn
  protocol             = "sqs"
  endpoint             = aws_sqs_queue.ext_{{../name}}.arn
  raw_message_delivery = true
}

# Allow SNS to send messages to this SQS queue
resource "aws_sqs_queue_policy" "ext_{{../name}}_sns_{{this}}" {
  queue_url = aws_sqs_queue.ext_{{../name}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "sns.amazonaws.com" }
        Action    = "sqs:SendMessage"
        Resource  = aws_sqs_queue.ext_{{../name}}.arn
        Condition = {
          ArnEquals = {
            "aws:SourceArn" = aws_sns_topic.ext_{{this}}.arn
          }
        }
      }
    ]
  })
}
{{/each}}
{{/each}}
{{/compare}}

