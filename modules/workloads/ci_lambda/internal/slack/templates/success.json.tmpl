{
  "blocks": [
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": {{json (printf ":white_check_mark: *Deployment Successful*\n*Environment:* %s\n*Service:* %s\n*Status:* %s" .Env .Service .State)}}
      }
    }{{if .DeploymentID}},
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": {{json (printf "Deployment ID: %s" .DeploymentID)}}
        }
      ]
    }{{end}}{{if .TaskDef}},
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": {{json (printf "Task Definition: %s" .TaskDef)}}
        }
      ]
    }{{end}}
  ]
}
