{
  "blocks": [
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": {{json (printf ":x: *Deployment Failed*\n*Environment:* %s\n*Service:* %s\n*Status:* %s" .Env .Service .State)}}
      }
    }{{if .Reason}},
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": {{json (printf "*Reason:* %s" .Reason)}}
      }
    }{{end}}{{if .DeploymentID}},
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": {{json (printf "Deployment ID: %s" .DeploymentID)}}
        }
      ]
    }{{end}}
  ]
}
