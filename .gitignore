# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
*.log

# Ignore any .tfvars files that are generated automatically for each Terraform run. Most
# .tfvars files are managed as part of configuration and so should be included in
# version control.
#
# example.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
#
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*
.supermaven
modules/workloads/ci_lambda/bootstrap
app/infrastructure
app/dev.yaml
app/prod.yaml

# meroku writes <env>.yaml into whatever directory it is run from, and that file
# carries account_id, aws_profile, state bucket names and notification emails.
# Only app/*.yaml was ignored, so running the binary from the repository root —
# which is the natural thing to do while developing — dropped a config holding a
# real AWS account ID into an unignored path in a PUBLIC repository, one
# `git add -A` away from being published. The tracked sample lives at
# project/dev.yaml and is deliberately blank; these are the runtime ones.
/dev.yaml
/prod.yaml
/staging.yaml
modules/appsync/auth_lambda/.yarn
modules/appsync/auth_lambda/node_modules
modules/appsync/auth_lambda.zip
dist/
app/meroku
app/meroku_test
.positions/
env/dev/.terraform.lock.hcl
**/.terraform.lock.hcl
*.bak
meroku
meroku_test

# OS files
.DS_Store
Thumbs.db

# Backup files
*.backup_*
project/backup/
.claudemem/index.db
.claudemem/vectors/code_chunks.lance

.mnemex/

# Local agent/tooling runtime state (not team history)
.claude/scheduled_tasks.lock
.claude/cache/
.claude/.statusline-worktree-*
.claude/_profiles/
.claude/worktrees/
**/.claude/.coaching/
.agents/
gtd/sessions/

# Real infrastructure identifiers - THIS REPO IS PUBLIC, see CLAUDE.md
modules/neon/scripts/db-access.json

# dev-session.sh build output
/bin/
/.claude/settings.local.json
/web/.playwright-cli
/web/output/playwright/.playwright-cli
/web/output/playwright

# Working artifacts from AI-assisted development sessions: requirements drafts,
# review transcripts, decision logs, captured diffs. They are scratch material,
# not documentation — and they routinely quote real account IDs, ARNs, policy
# IDs and hostnames straight out of live AWS responses, which this PUBLIC repo
# must never carry. Finished documentation belongs in ai_docs/ directly, where
# it gets written with synthetic placeholders.
ai_docs/sessions/
# The directory actually in use is ai-docs/ with a hyphen, so the rule above
# never matched and session artifacts have been committed here before. Both
# spellings are listed rather than one corrected, because the underscore form
# is what the paragraph above was written against and either could reappear.
ai-docs/sessions/

# Generated Terraform.
#
# `meroku generate <env>` renders env/main.hbs into env/<env>/*.tf inside a
# PROJECT directory. Only the template is source; the render is build output and
# is rewritten on every generate.
#
# project/env/dev/main.tf was committed by accident and sat here for two major
# versions, stale and syntactically invalid ("backend_remote_access = " with no
# value), which is why `terraform fmt -recursive .` could not parse the
# repository at all.
project/env/
/env/*/
